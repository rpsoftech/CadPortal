# Looks at the server (disk, memory, containers, web address) and sends a Telegram/webhook message when
# something is wrong. Install: see "Alerts" in the README. Edit User and the paths to match the server.
[Unit]
Description=CadPortal server watchdog
After=docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/cadportal
ExecStart=/opt/cadportal/scripts/watchdog.sh
