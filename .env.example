# Local dev DB (docker-compose.yml)
DATABASE_URL=postgres://cad:cad@localhost:5433/cad_portal?sslmode=disable
# Tests wipe this database; its name must end in _test
TEST_DATABASE_URL=postgres://cad:cad@localhost:5433/cad_portal_test?sslmode=disable
# Shared testing Postgres on the server (read-only checks; ask before writes)
TEST_SERVER_DATABASE_URL=
HTTP_ADDR=:8080
AUTO_MIGRATE=true

# Auth: HS256 secret (32+ chars). Dev tokens: go run ./cmd/devtoken admin
JWT_SECRET=
# CAD vault storage. Production uses Cloudflare R2 (set S3_BUCKET and the S3_* values).
# For local development set STORAGE=local to keep uploads on disk instead (never in production).
# Leave both unset to disable upload/download.
STORAGE=
LOCAL_STORAGE_DIR=data/uploads
# Cloudflare R2:
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=cad-vault
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
