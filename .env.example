# Local dev DB (docker-compose.yml)
DATABASE_URL=postgres://cad:cad@localhost:5433/cad_portal?sslmode=disable
# Tests wipe this database; its name must end in _test
TEST_DATABASE_URL=postgres://cad:cad@localhost:5433/cad_portal_test?sslmode=disable
# Shared testing Postgres on the server (read-only checks; ask before writes)
TEST_SERVER_DATABASE_URL=
HTTP_ADDR=:8080
AUTO_MIGRATE=true

# Auth: HS256 signing secret, 32+ characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
# CAD vault storage. Production uses Cloudflare R2 (set S3_BUCKET and the S3_* values).
# For local development set STORAGE=local to keep uploads on disk instead (never in production).
# Leave both unset to disable upload/download.
STORAGE=
LOCAL_STORAGE_DIR=data/uploads
# Cloudflare R2:
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=cad-vault
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Production stack (docker-compose.prod.yml). Compose reads this file itself,
# so JWT_SECRET and the S3_* values above are shared with it.
# ---------------------------------------------------------------------------
# How long the audit log is kept, in days. 0 (or unset) keeps everything.
AUDIT_RETENTION_DAYS=0
# Required. Use only URL-safe characters (it goes into DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=cad
POSTGRES_DB=cad_portal
# Where the web container listens on the host. Keep 127.0.0.1 and put a TLS proxy in front.
WEB_BIND=127.0.0.1
WEB_PORT=8080
