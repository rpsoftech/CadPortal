# Local dev DB (docker-compose.yml)
DATABASE_URL=postgres://cad:cad@localhost:5433/cad_portal?sslmode=disable
# Tests wipe this database; its name must end in _test
TEST_DATABASE_URL=postgres://cad:cad@localhost:5433/cad_portal_test?sslmode=disable
# Shared testing Postgres on the server (read-only checks; ask before writes)
TEST_SERVER_DATABASE_URL=
HTTP_ADDR=:8080
AUTO_MIGRATE=true

# Auth: HS256 signing secret, 32+ characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
# CAD vault storage. Production uses Cloudflare R2 (set S3_BUCKET and the S3_* values).
# For local development set STORAGE=local to keep uploads on disk instead (never in production).
# Leave both unset to disable upload/download.
STORAGE=
LOCAL_STORAGE_DIR=data/uploads
# Cloudflare R2:
# Fill all four of these in together, or leave them all empty (CAD upload/download is then off).
S3_ENDPOINT=
# Example endpoint: https://<account_id>.r2.cloudflarestorage.com   Example bucket: cad-vault
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Production stack (docker-compose.prod.yml). Compose reads this file itself,
# so JWT_SECRET and the S3_* values above are shared with it.
# ---------------------------------------------------------------------------
# How long the audit log is kept, in days. 0 (or unset) keeps everything.
AUDIT_RETENTION_DAYS=0
# How long a removed or replaced CAD file, photo or video, or a deleted variation, can still be restored before it is deleted
# for good, in days. Deleted designs are kept until someone restores them. 0 deletes files at once.
DELETED_FILE_RETENTION_DAYS=30
# Required. Use only URL-safe characters (it goes into DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=cad
POSTGRES_DB=cad_portal
# Logs: json (one line per request, for log tools; the default in the production stack) or text, and the
# level (debug, info, warn, error). Docker keeps the last 50 MB per container.
LOG_FORMAT=json
LOG_LEVEL=info
# Uptime monitoring: the API pings this URL every few minutes while it can reach its database, so a monitor
# such as Healthchecks.io or Uptime Kuma (push monitor) alerts you when the pings STOP. Nothing needs to be
# reachable from outside. Treat the URL like a secret. Empty means off.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_MINUTES=5
# The same for backups: pinged after every GOOD backup (make the monitor expect one about every 26 hours).
BACKUP_HEARTBEAT_URL=
# Public address of the portal (no path, like https://cad.example.com). It goes into emailed reset links and
# into the QR code on every job bag (a link to the design page); empty, the QR holds the plain variation code.
# Password reset by email ("Forgot password" on the sign-in page) is optional: without SMTP_HOST, people ask an
# admin, who makes a one-hour reset link on the Users screen. Use a mail account made for this, not a personal one.
APP_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587, the default), implicit (port 465) or none (a local mail catcher only)
SMTP_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Where the web container listens on the host. Keep 127.0.0.1 and put a TLS proxy in front.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# ---------------------------------------------------------------------------
# Backups (the backup service in docker-compose.prod.yml). See "Backups" in the README.
# Turn the service on:  COMPOSE_PROFILES=backup
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=
# A SECOND bucket (never the vault bucket) with its own token that can only read and write that bucket.
# The endpoint defaults to S3_ENDPOINT, which is right when both buckets are in the same R2 account.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Database dumps are encrypted to this PUBLIC key. Make the pair with:
#   docker compose -f docker-compose.prod.yml --profile backup run --rm backup keygen
# and keep the secret key offline: without it no dump can be opened. Only the public key goes here.
BACKUP_AGE_RECIPIENT=
# When it runs (24 hour clock in BACKUP_TZ) and how many dumps are kept; one dump per year is kept for good.
BACKUP_AT=02:00
BACKUP_TZ=UTC
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
# Optional: let admins see the stored dumps and download them (still encrypted) on the Backups screen.
# This needs a SECOND token for the backup bucket that can only READ; the portal never gets the token the
# backup service writes with. Without it the screen shows run history and "Back up now" only.
BACKUP_VIEW_ACCESS_KEY_ID=
BACKUP_VIEW_SECRET_ACCESS_KEY=
# The setup checklist warns admins when the last good backup is older than this many hours (default 36).
# BACKUP_MAX_AGE_HOURS=36

# ---------------------------------------------------------------------------
# Real R2 checks (go test ./internal/storage -run R2 -v). Use a SCRATCH bucket and a token limited
# to it: the tests write and delete objects under r2-test/. These names differ from S3_* on
# purpose, so a production value can never point the tests at the live bucket.
# ---------------------------------------------------------------------------
R2_TEST_ENDPOINT=
R2_TEST_BUCKET=
R2_TEST_ACCESS_KEY_ID=
R2_TEST_SECRET_ACCESS_KEY=

# Where photos and video are loaded from (the Content-Security-Policy of the web container).
# Only needed if R2 is reached through a custom domain; the default is the R2 endpoint host.
# MEDIA_ORIGINS=https://*.r2.cloudflarestorage.com
