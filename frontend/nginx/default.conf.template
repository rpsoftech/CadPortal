# Rendered by the nginx image entrypoint: ${API_UPSTREAM} comes from the environment.

# Docker's embedded DNS. With the upstream held in a variable, nginx resolves it per
# request, so it starts even if the API is not up yet and follows API restarts.
resolver 127.0.0.11 valid=10s ipv6=off;

# Sign-in attempts per client address. The API locks an account after 5 failures; this limit
# also stops one client from guessing across many accounts. 10 a minute with a burst of 20
# leaves plenty of room for people sharing an office address.
limit_req_zone $binary_remote_addr zone=login:2m rate=10r/m;
# Password reset requests and reset attempts: 5 a minute per client address, with a burst of 10.
limit_req_zone $binary_remote_addr zone=reset:2m rate=5r/m;

server {
    listen 8080;
    server_name _;
    server_tokens off;

    # When a TLS proxy sits in front, the client address arrives in X-Forwarded-For. It is
    # believed only from private and loopback peers (the proxy), so an outside client cannot
    # choose the address the rate limit sees.
    set_real_ip_from 127.0.0.0/8;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    set $api_upstream "http://${API_UPSTREAM}";

    # The Angular production build has no inline scripts, so script-src needs no 'unsafe-inline'.
    # Angular Material sets inline styles at runtime, hence style-src 'unsafe-inline'. Photos and
    # video are shown straight from the object store through signed links, so its address is
    # allowed for images and media only, never for scripts or connections.
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: ${MEDIA_ORIGINS}; media-src 'self' ${MEDIA_ORIGINS}; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/security-headers.conf;

    # Container health probe.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Sign-in is rate limited (429 when exceeded); everything else under /api/ is not.
    location = /api/v1/auth/login {
        limit_req zone=login burst=20 nodelay;
        limit_req_status 429;
        include /etc/nginx/api-proxy.conf;
    }

    # "Forgot password" and the reset form are public, so they are limited per client address too: they
    # would otherwise be a way to flood someone's inbox or to guess reset tokens.
    location = /api/v1/auth/forgot-password {
        limit_req zone=reset burst=10 nodelay;
        limit_req_status 429;
        include /etc/nginx/api-proxy.conf;
    }
    location = /api/v1/auth/reset-password {
        limit_req zone=reset burst=10 nodelay;
        limit_req_status 429;
        include /etc/nginx/api-proxy.conf;
    }

    # ^~ so the static-file rule below (anything ending in .jpg, .png, ...) can never take over an
    # API path: photos are served from /api/v1/local-files/.../name.jpg.
    location ^~ /api/ {
        include /etc/nginx/api-proxy.conf;
    }

    # Build output has content hashes in its names, so it can be cached for a year.
    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpe?g|webp|ico)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/security-headers.conf;
    }

    # The app shell must always be revalidated so a new deploy is picked up.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
    }
}
